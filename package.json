{
  "name": "templateit",
  "version": "1.1.0",
  "description": "TemplateIT — local Electron app for prompt templates with fill slots, history, and offline storage",
  "main": "electron/main.cjs",
  "type": "module",
  "author": "TemplateIT contributors",
  "license": "MIT",
  "homepage": "https://github.com/nvmaditya/templateit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nvmaditya/templateit.git"
  },
  "bugs": {
    "url": "https://github.com/nvmaditya/templateit/issues"
  },
  "keywords": [
    "electron",
    "prompt",
    "templates",
    "chatbot",
    "local-first",
    "TemplateIT"
  ],
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/**/*.test.js",
    "smoke:main": "node scripts/smoke-main.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "prebuild": "npm run icons && npm test",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:dir": "electron-builder --win dir --publish never",
    "pack": "electron-builder --dir --publish never"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.templateit.app",
    "productName": "TemplateIT",
    "copyright": "Copyright © 2026 TemplateIT contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "icon": "build/icon.ico",
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json",
      "node_modules/@phosphor-icons/web/**/*"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TemplateIT",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
